[alias]
    # Resolves the remote's default branch instead of assuming master or main,
    # which is what the old -main alias duplicates were working around.
    # Falls back to main when origin/HEAD is unset (`git remote set-head origin -a`).
    default-branch = "!f() { b=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); b=${b#origin/}; [ -n \"$b\" ] || b=main; echo \"$b\"; }; f"
    branch-name = rev-parse --abbrev-ref HEAD

    append = commit --amend --no-edit
    edit-message = commit --amend
    b = branch
    c = checkout
    diff-origin = "!git diff origin/$(git default-branch)..."
    diff-origin-files = "!git diff --name-status origin/$(git default-branch)"
    diff-staged = diff --cached
    log-graph = log --oneline --graph --decorate
    log-origin = "!d=$(git default-branch); git log origin/$d ^$d"
    ls-alias = "!git config -l | grep alias | cut -c 7-"
    pc = pull-clean
    pc-all = pull-clean-all
    publish = "!git push -u origin $(git branch-name)"
    s = switch
    undo = reset HEAD~
    up = "!git fetch && git rebase origin/$(git default-branch) --autostash"
[init]
    defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
    rebase = false  # defult
    # rebase = true
    # ff = only
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
