#!/bin/bash

CYAN='\033[0;36m'
NC='\033[0m' # No Color
function print() {
  echo -e "${CYAN}==> $1${NC}"
}

print 'updating homebrew'
brew update
# `brew upgrade` covers casks too since Homebrew 4, so no separate --casks pass.
brew upgrade
brew cleanup -s

print 'updating Mac App Store apps'
mas upgrade

print 'pipx packages'
pipx upgrade-all

print 'updating asdf'
asdf plugin update --all

for tool in nodejs python java; do
  asdf plugin list 2>/dev/null | grep -qx "$tool" || continue
  print "updating $tool"
  if [ "$tool" = java ]; then
    version=$(asdf latest java openjdk)
  else
    version=$(asdf latest "$tool")
  fi
  asdf install "$tool" "$version"
  asdf set --home "$tool" "$version"
done

print 'updating fish shell'
fish -c "fisher update"
# fish -c fish_update_completions

# Left to you rather than run here: it needs sudo, and prompting for a password
# at the end of a long unattended run means the script just sits there.
print 'Apple Updates — run this yourself:'
echo '    sudo softwareupdate -ia'
