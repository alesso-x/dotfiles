#!/bin/bash

CYAN='\033[0;36m'
NC='\033[0m' # No Color
function print() {
  echo -e "${CYAN}==> $1${NC}"
}

print 'dumping brew bundle'
# --no-vscode: brew bundle dump now emits `vscode` lines from the *default*
# profile, which would fight with vscode/extensions dumped below.
brew bundle dump --force --no-vscode --file=$DOTFILES_HOME/macOS/Brewfile

print 'dumping vscode extensions'
code --profile Personal --list-extensions > $DOTFILES_HOME/vscode/extensions
