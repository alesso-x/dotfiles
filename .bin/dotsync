#!/bin/bash

CYAN='\033[0;36m'
NC='\033[0m' # No Color
function print() {
  echo -e "${CYAN}==> $1${NC}"
}

# Extensions live in a named profile, not the default one. Both the diff and
# the dump below must agree on it or every run reports the whole list as new.
VSCODE_PROFILE=Personal

print 'pulling latest changes'
git -C $DOTFILES_HOME pull --ff-only

ret=$?
if ! test "$ret" -eq 0; then
  echo >&2 "git pull failed with exit status $ret"
  exit 1
fi

print 'syncing brew'
# Apps that ship with macOS or are too big to want mas re-downloading. This
# has to be exported *before* the check, not just before the install: `check`
# honours it too, and without it any skipped app reads as missing, so the
# guard below can never pass and the install runs on every single sync.
export HOMEBREW_BUNDLE_MAS_SKIP="Keynote Numbers Pages Xcode"
brew bundle check --file=$DOTFILES_HOME/macOS/Brewfile
if ! test "$?" -eq 0; then
  brew bundle install --file=$DOTFILES_HOME/macOS/Brewfile
fi
# --no-vscode: brew bundle dump now emits `vscode` lines from the *default*
# profile, which would fight with vscode/extensions maintained below.
brew bundle dump --force --no-vscode --file=$DOTFILES_HOME/macOS/Brewfile

print 'syncing vscode extensions'
NEW_EXTENSIONS=$(comm -13 \
  <(code --profile $VSCODE_PROFILE --list-extensions | sort) \
  <(sort $DOTFILES_HOME/vscode/extensions))
if ! test -z "$NEW_EXTENSIONS"; then
  echo "New extensions:"
  echo "$NEW_EXTENSIONS"
  echo "$NEW_EXTENSIONS" | xargs -n 1 code --profile $VSCODE_PROFILE --install-extension
fi
code --profile $VSCODE_PROFILE --list-extensions > $DOTFILES_HOME/vscode/extensions

print 'backing up fish_history'
cp $HOME/.local/share/fish/fish_history $DOTFILES_HOME/_backup/

git -C $DOTFILES_HOME status
